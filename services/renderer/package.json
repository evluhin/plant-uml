{
  "name": "plantuml-renderer",
  "version": "1.0.0",
  "description": "AWS Lambda PlantUML renderer service",
  "main": "dist/handler.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:integration": "jest --testPathPattern=integration",
    "test:local": "./test-local.sh",
    "lint": "eslint src --ext .ts",
    "fmt": "prettier --write src",
    "clean": "rm -rf dist .aws-sam node_modules",
    "setup": "./dev-setup.sh",
    "local": "AWS_ACCESS_KEY_ID=dummy AWS_SECRET_ACCESS_KEY=dummy AWS_DEFAULT_REGION=eu-north-1 NODE_ENV=development sam local start-api --port 3001 --env-vars .env.local --skip-pull-image",
    "local:watch": "./watch-local.sh",
    "deploy:dev": "sam deploy --config-env dev",
    "deploy:prod": "sam deploy --config-env prod"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^1.17.0",
    "@aws-lambda-powertools/metrics": "^1.17.0",
    "@aws-sdk/client-ssm": "^3.450.0",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.130",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/supertest": "^2.0.16",
    "jest": "^29.7.0",
    "nodemon": "^3.0.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1"
  }
}
