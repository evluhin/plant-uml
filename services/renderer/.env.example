# Renderer Service Environment Variables Example
# Copy to .env and fill in your values

# AWS Configuration
AWS_PROFILE=default
AWS_DEFAULT_REGION=eu-north-1

# JWT Configuration
JWT_SECRET_PARAM=/plantuml/renderer/jwt-secret
EXPECTED_ISSUER=plantuml-confluence

# Development Settings
NODE_ENV=development
LOCAL_JWT_SECRET=your-local-jwt-secret-for-testing
LOG_PAYLOADS=false

# PlantUML Configuration
PLANTUML_JAR=/opt/plantuml.jar
GRAPHVIZ_DOT=/opt/bin/dot

# Testing
TEST_API_URL=http://localhost:3001