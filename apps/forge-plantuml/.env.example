# Forge App Environment Variables Example
# Copy to .env and fill in your values

# Renderer Service
# Development environment
RENDERER_URL=https://q2cro7gz51.execute-api.eu-north-1.amazonaws.com/dev
RENDERER_JWT_SECRET=your-dev-jwt-secret-key

# Production environment (use these values for production deployment)
# RENDERER_URL=https://gezrf8c2xa.execute-api.eu-north-1.amazonaws.com/prod
# RENDERER_JWT_SECRET=your-prod-jwt-secret-key

# Forge Configuration
FORGE_APP_ID=your-forge-app-id

# Development Settings
NODE_ENV=development
VITE_DEV_MODE=true