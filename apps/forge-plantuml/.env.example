# Forge App Environment Variables Example
# Copy to .env and fill in your values

# Renderer Service
RENDERER_URL=https://your-api-id.execute-api.region.amazonaws.com/dev
RENDERER_JWT_SECRET=your-jwt-secret-key

# Forge Configuration
FORGE_APP_ID=your-forge-app-id

# Development Settings
NODE_ENV=development
VITE_DEV_MODE=true