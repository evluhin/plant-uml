# Root Environment Variables Example
# Copy to .env and fill in your values

# AWS Configuration
AWS_PROFILE=default
AWS_DEFAULT_REGION=eu-north-1

# Forge Configuration
FORGE_APP_ID=your-forge-app-id
FORGE_API_TOKEN=your-forge-api-token

# Renderer Configuration
RENDERER_URL=https://pb3hubgska.execute-api.eu-north-1.amazonaws.com/dev
RENDERER_JWT_SECRET=your-jwt-secret-key

# Development Settings
NODE_ENV=development
LOG_LEVEL=info