# Root Environment Variables
# Copy to .env and fill in your values
# See docs/ONPREMISE_DEPLOYMENT.md for full setup guide

# AWS Configuration
AWS_PROFILE=default
AWS_DEFAULT_REGION=eu-north-1

# Forge Configuration
FORGE_APP_ID=ari:cloud:ecosystem::app/your-app-uuid
FORGE_API_TOKEN=your-forge-api-token

# Renderer Configuration
# Replace with your API Gateway URLs from CloudFormation outputs
RENDERER_URL=https://your-api-id.execute-api.your-region.amazonaws.com/dev
RENDERER_JWT_SECRET=your-jwt-secret-key

# Development Settings
NODE_ENV=development
LOG_LEVEL=info
