{
  "name": "plantuml-confluence",
  "version": "1.0.0",
  "description": "PlantUML editing and rendering for Confluence Cloud",
  "private": true,
  "workspaces": [
    "apps/forge-plantuml",
    "services/renderer"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "fmt": "npm run fmt --workspaces",
    "clean": "npm run clean --workspaces && rm -rf node_modules",
    "deploy": "./deploy.sh",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",

    "axios": "^1.11.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "husky": "^8.0.3",
    "lint-staged": "^15.1.0",
    "prettier": "^3.1.0",

  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "packageManager": "npm@10.0.0",
  "dependencies": {
    "@forge/api": "^3.9.2",
    "@forge/bridge": "^3.5.0",
    "@forge/react": "^10.11.1",
    "jsonwebtoken": "^9.0.2"
  }
}
