{
  "name": "plantuml-confluence",
  "version": "1.0.0",
  "description": "PlantUML editing and rendering for Confluence Cloud",
  "private": true,
  "workspaces": [
    "apps/forge-plantuml",
    "services/renderer"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "fmt": "npm run fmt --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "deploy": "./deploy.sh",
    "prepare": "husky install",
    "precommit": "lint-staged",
    "update-deps": "npm update && npm audit fix"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "axios": "^1.12.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "packageManager": "npm@10.0.0",
  "dependencies": {
    "@forge/api": "^6.1.1",
    "@forge/bridge": "^5.5.0",
    "@forge/react": "^11.3.0",
    "jsonwebtoken": "^9.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
