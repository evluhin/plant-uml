FROM node:20-alpine

# Install required packages for keychain support
RUN apk add --no-cache libsecret-dev

# Install Forge CLI
RUN npm install -g @forge/cli

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./
COPY apps/forge-plantuml/package*.json ./apps/forge-plantuml/

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Build the project
RUN npm run build

# Expose port for tunnel
EXPOSE 3000

CMD ["sh"]